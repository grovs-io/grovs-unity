/* Links */

.links__bar {
    padding: 12px 16px;
    background-color: var(--background);
    border-top-width: 1px;
    border-top-color: var(--divider);
}

.result-card {
    margin-top: 12px;
    padding: 12px;
    border-radius: 12px;
    border-width: 1px;
}

.result-card.state-ok {
    background-color: rgba(221, 251, 231, 0.35);
    border-color: rgba(27, 163, 75, 0.35);
}

.result-card.state-error {
    background-color: rgba(251, 232, 233, 0.35);
    border-color: rgba(220, 38, 38, 0.35);
}

.theme-dark .result-card.state-ok {
    background-color: rgba(28, 92, 49, 0.35);
    border-color: rgba(52, 196, 106, 0.35);
}

.theme-dark .result-card.state-error {
    background-color: rgba(248, 113, 113, 0.07);
    border-color: rgba(248, 113, 113, 0.35);
}

.result-card__header {
    flex-direction: row;
    align-items: center;
}

.result-card__status {
    flex-grow: 1;
    margin-left: 6px;
    color: var(--text-muted);
}

.result-card__link {
    margin-top: 6px;
    margin-bottom: 6px;
    color: var(--accent);
    white-space: normal;
}

.result-card__error {
    margin-top: 6px;
    color: var(--error);
    white-space: normal;
}

.result-card__actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.link-form__gap {
    margin-top: 10px;
}

.utm-row {
    flex-direction: row;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-left: -5px;
}

.utm-row > * {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 5px;
}

.redirect-editor {
    padding-top: 6px;
    padding-bottom: 6px;
}

.redirect-editor__samples {
    margin-top: 6px;
}

.links > .screen {
    flex-grow: 1;
    flex-basis: 0;
}

.links__bar {
    flex-shrink: 0;
}

/* Events */

.events > .screen {
    flex-grow: 1;
    flex-basis: 0;
}

.events__full {
    margin-top: 8px;
}

.events__row {
    flex-direction: row;
    align-items: center;
}

.events__grow {
    flex-grow: 1;
    flex-basis: 0;
}

.events__small {
    margin-left: 6px;
    min-width: 72px;
}

.events__gap,
.event-form__gap {
    margin-top: 10px;
}

.event-form__anyway {
    align-self: flex-start;
}

.events__sheet-title {
    margin-bottom: 8px;
}

.receipt-field {
    min-height: 120px;
}

/* In-app */

.in-app > .screen,
.excluded-view > .screen {
    flex-grow: 1;
    flex-basis: 0;
}

.in-app__row {
    flex-direction: row;
    align-items: center;
}

.in-app__grow {
    flex-grow: 1;
    flex-basis: 0;
}

.in-app__small {
    margin-left: 6px;
    min-width: 72px;
}

.in-app__second {
    margin-left: 8px;
}

.in-app__gap {
    margin-top: 10px;
}

.in-app__chevron {
    color: var(--text-faint);
}

/* Excluded screen */

.excluded-view {
    flex-grow: 1;
    background-color: var(--background);
}

.excluded-view__intro {
    color: var(--text-muted);
    white-space: normal;
    padding-top: 8px;
    padding-bottom: 8px;
}

.excluded-view__latest {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.excluded-view__text {
    flex-shrink: 1;
    margin-left: 8px;
    color: var(--text-muted);
    white-space: normal;
}

.excluded-view__back {
    margin-top: 16px;
}

/* Home */

.home__header {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 4px;
}

.home__logo {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background-color: var(--accent);
    align-items: center;
    justify-content: center;
}

.home__logo-text {
    color: #FFFFFF;
    -unity-font-definition: url("Fonts/Geist-Bold SDF.asset");
}

.home__title {
    flex-grow: 1;
    margin-left: 8px;
}

.home__caption {
    color: var(--text-muted);
    margin-right: 4px;
}

.home__muted {
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.home__empty {
    color: var(--text-muted);
    padding-top: 8px;
    padding-bottom: 8px;
}

.home__chips {
    margin-top: 6px;
}

.home__gap {
    margin-top: 10px;
}

.home__buttons {
    flex-direction: row;
    margin-top: 10px;
    margin-left: -8px;
}

.home__buttons > * {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 8px;
}

.home__grid-row {
    flex-direction: row;
    margin-left: -8px;
}

.home__grid-row > * {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 8px;
}

.home__grid-row--second {
    margin-top: 8px;
}

.home__sheet-title {
    margin-bottom: 8px;
}

.home__sheet-button {
    margin-top: 12px;
}

.home__link {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
