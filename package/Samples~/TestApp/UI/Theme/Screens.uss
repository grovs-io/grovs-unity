/* Links */

.links__bar {
    padding: 12px 16px;
    background-color: var(--background);
    border-top-width: 1px;
    border-top-color: var(--divider);
}

.result-card {
    margin-top: 12px;
    padding: 12px;
    border-radius: 12px;
    border-width: 1px;
}

.result-card.state-ok {
    background-color: rgba(221, 251, 231, 0.35);
    border-color: rgba(27, 163, 75, 0.35);
}

.result-card.state-error {
    background-color: rgba(251, 232, 233, 0.35);
    border-color: rgba(220, 38, 38, 0.35);
}

.theme-dark .result-card.state-ok {
    background-color: rgba(28, 92, 49, 0.35);
    border-color: rgba(52, 196, 106, 0.35);
}

.theme-dark .result-card.state-error {
    background-color: rgba(248, 113, 113, 0.07);
    border-color: rgba(248, 113, 113, 0.35);
}

.result-card__header {
    flex-direction: row;
    align-items: center;
}

.result-card__status {
    flex-grow: 1;
    margin-left: 6px;
    color: var(--text-muted);
}

.result-card__link {
    margin-top: 6px;
    margin-bottom: 6px;
    color: var(--accent);
    white-space: normal;
}

.result-card__error {
    margin-top: 6px;
    color: var(--error);
    white-space: normal;
}

.result-card__actions {
    flex-direction: row;
    flex-wrap: wrap;
}

.link-form__gap {
    margin-top: 10px;
}

.utm-row {
    flex-direction: row;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-left: -5px;
}

.utm-row > * {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 5px;
}

.redirect-editor {
    padding-top: 6px;
    padding-bottom: 6px;
}

.redirect-editor__samples {
    margin-top: 6px;
}

.links > .screen {
    flex-grow: 1;
    flex-basis: 0;
}

.links__bar {
    flex-shrink: 0;
}

/* Events */

.events > .screen {
    flex-grow: 1;
    flex-basis: 0;
}

.events__full {
    margin-top: 8px;
}

.events__row {
    flex-direction: row;
    align-items: center;
}

.events__grow {
    flex-grow: 1;
    flex-basis: 0;
}

.events__small {
    margin-left: 6px;
    min-width: 72px;
}

.events__gap,
.event-form__gap {
    margin-top: 10px;
}

.event-form__anyway {
    align-self: flex-start;
}

.events__sheet-title {
    margin-bottom: 8px;
}

.receipt-field {
    min-height: 120px;
}
