<?xml version="1.0" encoding="utf-8"?>
<!-- Sample only. Uses the native Grovs build published to mavenLocal. -->
<dependencies>
  <androidPackages>
    <repositories>
      <repository>file:///path/to/.m2/repository</repository>
    </repositories>

    <!-- mavenLocal has no maven-metadata.xml, so Gradle cannot match the package's version range here. -->
    <androidPackage spec="io.grovs:Grovs:3.1.0" />

    <!-- The mavenLocal Grovs pom lists no dependencies, so its runtime deps are declared here. -->
    <androidPackage spec="androidx.core:core-ktx:1.13.1" />
    <androidPackage spec="androidx.appcompat:appcompat:1.5.0" />
    <androidPackage spec="androidx.fragment:fragment-ktx:1.8.4" />
    <androidPackage spec="androidx.webkit:webkit:1.11.0" />
    <androidPackage spec="androidx.navigation:navigation-runtime-ktx:2.8.3" />
    <androidPackage spec="androidx.lifecycle:lifecycle-runtime-ktx:2.6.2" />
    <androidPackage spec="androidx.lifecycle:lifecycle-livedata-core-ktx:2.6.2" />
    <androidPackage spec="org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3" />
    <androidPackage spec="com.squareup.retrofit2:retrofit:2.9.0" />
    <androidPackage spec="com.squareup.retrofit2:converter-gson:2.9.0" />
    <androidPackage spec="com.squareup.okhttp3:okhttp:4.9.0" />
    <androidPackage spec="com.squareup.okhttp3:logging-interceptor:4.9.0" />
    <androidPackage spec="com.google.code.gson:gson:2.9.0" />
    <androidPackage spec="com.android.installreferrer:installreferrer:2.1" />
  </androidPackages>
</dependencies>
